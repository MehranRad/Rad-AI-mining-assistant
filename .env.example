# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.
#
# MySQL credentials for the `mining_ai` database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=mining_ai

# Secret used to sign JWTs. Generate with e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me

# Local Ollama model used for SQL generation / classification / final answers.
# Defaults to qwen3:4b-instruct-2507-q4_K_M when unset.
#MODEL_NAME=qwen3:4b-instruct-2507-q4_K_M

# Comma-separated list of allowed frontend origins for CORS.
# Defaults to http://localhost:3000 when unset.
#CORS_ORIGINS=http://localhost:3000